# ─────────────────────────────────────────────
# LensGuard — Environment Variable Reference
# Copy this file to .env and adjust as needed.
# ─────────────────────────────────────────────

# ── Backend ──────────────────────────────────
# Path to the SQLite database file (inside container)
DB_PATH=/app/data/lensguard.db

# Path to the ML model directory (inside container)
MODEL_PATH=/app/ml/models

# Active model version (directory name under MODEL_PATH)
MODEL_VERSION=v1

# Maximum upload file size in megabytes
MAX_UPLOAD_MB=20

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# Directory where uploaded images + thumbnails are stored
UPLOAD_DIR=/app/data/uploads

# Directory where Grad-CAM heatmap PNGs are stored
HEATMAP_DIR=/app/data/heatmaps

# Uvicorn host and port
HOST=0.0.0.0
PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Frontend (Vite build-time) ────────────────
# Backend API base URL as seen from the browser
VITE_API_BASE_URL=http://localhost:8000
