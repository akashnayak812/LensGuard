# ────────────────────────────────────────────────────────────────────────────
# LensGuard Backend — Dockerfile
# Base: python:3.11-slim | Runs: uvicorn on port 8000
# ────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS base

# Install OS-level deps for OpenCV (headless) and TensorFlow
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Install Python deps (layer-cached) ──────────────────────────────────────
COPY backend/requirements.txt /app/backend/requirements.txt
COPY ml/requirements.txt       /app/ml/requirements.txt

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/backend/requirements.txt && \
    pip install --no-cache-dir -r /app/ml/requirements.txt

# ── Copy source code ─────────────────────────────────────────────────────────
COPY backend/ /app/backend/
COPY ml/      /app/ml/

# ── Create runtime directories ───────────────────────────────────────────────
RUN mkdir -p /app/data/uploads /app/data/heatmaps /app/data

# ── Non-root user ────────────────────────────────────────────────────────────
RUN useradd -m -u 1001 lensguard && \
    chown -R lensguard:lensguard /app
USER lensguard

# ── Environment defaults (overridden by docker-compose env) ──────────────────
ENV DB_PATH=/app/data/lensguard.db \
    MODEL_PATH=/app/ml/models \
    MODEL_VERSION=v1 \
    MAX_UPLOAD_MB=20 \
    CORS_ORIGINS=http://localhost,http://localhost:80 \
    UPLOAD_DIR=/app/data/uploads \
    HEATMAP_DIR=/app/data/heatmaps \
    LOG_LEVEL=INFO \
    HOST=0.0.0.0 \
    PORT=8000 \
    PYTHONPATH=/app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD wget -qO- http://localhost:8000/health || exit 1

COPY docker/entrypoint.sh /app/entrypoint.sh

CMD ["/bin/bash", "/app/entrypoint.sh"]
